# Reference code (vendor test project, not original work)
ref/

# ESP-IDF build artifacts
**/build/
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.defaults
**/dependencies.lock
**/__pycache__/

# IDF Component Manager generated files
**/.component_hash
**/managed_components/

# IDE / clangd
**/.cache/

# macOS
.DS_Store

# Internal dev notes (not for public)
/docs/internal/

# Private household context — room layout, occupancy, what each sensor sees.
# Facts about someone's home, not about the code. Never commit.
/docs/household/

# Local device configs (real MACs / labels) — keep .template committed
projects/*/main/device_config.h

# Vendor component bloat — not needed for builds, safe to exclude
# LVGL: only src/ and env_support/ are needed; demos/examples/tests/docs are optional extras
shared/components/lvgl__lvgl/demos/
shared/components/lvgl__lvgl/examples/
shared/components/lvgl__lvgl/tests/
shared/components/lvgl__lvgl/docs/
shared/components/lvgl__lvgl/scripts/

# Secrets for host-side tooling (Supabase service key, HF token)
.env
**/.env
.env.*
!.env.template

# project-local tooling venv
projects/*/tools/.venv/
